# Minimal Linux kernel config for RhetSim rv64imac simulator
# Base: rv64imac, no FPU, single hart, SBI console

# Architecture
CONFIG_ARCH_RV64I=y
CONFIG_CMODEL_MEDANY=y
CONFIG_MMU=y

# Disable extensions we don't have
CONFIG_RISCV_ISA_C=y
CONFIG_FPU=n
CONFIG_RISCV_ISA_V=n

# Single core
CONFIG_SMP=n
CONFIG_NR_CPUS=1

# Console / serial
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_HVC_RISCV_SBI=y

# SBI
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y

# Minimal filesystem for boot messages
CONFIG_PRINTK=y
CONFIG_BLK_DEV_INITRD=n

# No modules
CONFIG_MODULES=n

# Minimal
CONFIG_NET=n
CONFIG_WIRELESS=n
CONFIG_SOUND=n
CONFIG_USB=n
CONFIG_INPUT=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_VGA_CONSOLE=n

# Timer
CONFIG_RISCV_TIMER=y
